@startuml post-status-state
'=========================================================
'  State — حالة المنشور (Post Status)
'=========================================================
skinparam shadowing false
skinparam state {
  BackgroundColor White
}

title **حالة المنشور** — Post Status State Machine

state "المنشور\nPost" as P {

  state "active\n(نشط ومرئي)" as Active
  state "hidden\n(مخفي بسبب بلاغات)" as Hidden
  state "deleted\n(محذوف من صاحبه)" as Deleted

  [*] --> Active : نشر منشور جديد\nPost.create
  Active --> Hidden : reportsCount >= 10\n(إخفاء تلقائي)\nأو\nreviewReport('approve')
  Active --> Deleted : حذف من قبل صاحبه\ndeletePost()
  Hidden --> Active : إلغاء الإخفاء من الإدارة\nreviewReport('reject')
  Hidden --> Deleted : حذف من قبل صاحبه
  Deleted --> [*]
}

note bottom of Active
  خلال active فقط يمكن:
  - الإعجاب بالمنشور
  - التعليق عليه
  - الإبلاغ عنه
  - حفظه
end note

note bottom of Hidden
  reportsCount >= 10 → إخفاء تلقائي
  reportsCount >= 30 → حظر صاحب المنشور
  المنشور لا يظهر في القوائم
  لكن لا يُحذف من قاعدة البيانات
end note

note bottom of Deleted
  الحذف فقط من قبل صاحب المنشور
  لا يمكن استرجاعه
  يُحذف من قاعدة البيانات
end note

@enduml
