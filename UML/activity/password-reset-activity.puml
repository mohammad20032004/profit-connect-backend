@startuml password-reset-activity
'=========================================================
'  Activity — تدفق إعادة تعيين كلمة المرور
'=========================================================
skinparam activityDiamondFontSize 14
skinparam shadowing false
title **إعادة تعيين كلمة المرور** — Password Reset Activity

start
:المستخدم ينسى كلمة المرور;
:POST /api/auth/forgot-password\n{email}

if (البريد مسجل في المنصة؟) then (لا)
  :404 البريد غير مسجل;
  stop
else (نعم)
endif

:حذف أكواد إعادة التعيين القديمة\nPasswordReset.deleteMany();
:توليد كود عشوائي 6 أرقام\ngenerateResetCode();
:حفظ الكود في PasswordReset\nexpiresAt: now + 10 دقائق;
:إرسال الكود عبر EmailJS\nsendResetCode();

if (تم الإرسال؟) then (لا)
  :500 خطأ في الإرسال;
  stop
else (نعم)
endif

:عرض رسالة نجاح;
:المستخدم يدخل الكود;
:POST /api/auth/verify-reset-code\n{email, code}

:البحث عن الكود في PasswordReset\n(verified=false, expiresAt>now)

if (الكود منتهي/غير موجود؟) then (نعم)
  :400 لا يوجد كود صالح;
  stop
else (لا)
endif

if (الكود صحيح؟) then (لا)
  :400 الكود غير صحيح;
  stop
else (نعم)
endif

:تعليم الكود verified=true;
:إنشاء resetToken\n(صالح 10 دقائق);
:إرجاع resetToken;

:المستخدم يدخل كلمة المرور الجديدة;
:POST /api/auth/reset-password\n{resetToken, newPassword}

if (التوكن صالح؟) then (لا)
  :400 التوكن غير صالح/منتهي;
  stop
else (نعم)
endif

if (الطول >= 6؟) then (لا)
  :400 كلمة المرور قصيرة;
  stop
else (نعم)
endif

:تحديث كلمة المرور الجديدة\n(pre-save hook bcrypt);
:حذف جميع أكواد إعادة التعيين;
:إبطال جميع الريفرش توكنز\n(أمان إضافي);

:إرجاع رسالة نجاح;
:الانتقال لصفحة تسجيل الدخول;

stop

@enduml
