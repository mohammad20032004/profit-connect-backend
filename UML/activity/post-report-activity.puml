@startuml post-report-activity
'=========================================================
'  Activity — تدفق الإبلاغ عن منشور
'=========================================================
skinparam activityDiamondFontSize 14
skinparam shadowing false
title **الإبلاغ عن منشور** — Post Reporting Activity

start
:المستخدم يرى منشوراً مخالفاً;
:POST /api/posts/:postId/report\n{reason, description?}

:rateLimiter: 3 طلبات/دقيقة

if (المنشور موجود؟) then (لا)
  :404 المنشور غير موجود;
  stop
else (نعم)
endif

if (صاحب المنشور يبلغ عن نفسه؟) then (نعم)
  :400 لا يمكنك الإبلاغ عن منشورك;
  stop
else (لا)
endif

if (بلّغ مسبقاً؟) then (نعم)
  :400 قمت بالإبلاغ مسبقاً;
  stop
else (لا)
endif

:إنشاء PostReport\nstatus: 'pending';
:تحديث Post.reportsCount +1;
:تحديث User.reportsCount +1;
:إشعار لصاحب المنشور\n(post_reported);

' ===== فحص الحدود التلقائي =====
if (reportsCount >= 30؟) then (نعم)
  :إخفاء المنشور\nPost.status = 'hidden';
  :حظر المستخدم نهائياً\nUser.status = 'banned';
  :إشعار للمستخدم\n(account_banned);
  :إشعار للمبلغ\n(post_hidden);
elseif (reportsCount >= 10؟) then (نعم)
  :إخفاء المنشور تلقائياً\nPost.status = 'hidden';
  :إشعار للمستخدم\n(post_hidden);
else (< 10)
  :البلاغ ينتظر المراجعة\nمن الإدارة;
endif

:تم استلام البلاغ بنجاح;

' ===== مراجعة الإدارة =====
fork
  :Admin يرى البلاغات;\nGET /api/posts/admin/reports\n?status=pending;
fork again
  :Admin يراجع بلاغاً;\nPUT /api/posts/reports/:id/review\n{action, note};
end fork

if (الإجراء) then (approve)
  :تحديث PostReport.status = 'reviewed';
  :إخفاء المنشور\nPost.status = 'hidden';
  :إشعار للمبلغ\n(تمت الموافقة);
elseif (reject)
  :تحديث PostReport.status = 'rejected';
  :إشعار للمبلغ\n(تم الرفض);
endif

stop

@enduml
