@startuml password-reset-sequence
'=========================================================
'  Sequence — إعادة تعيين كلمة المرور عبر EmailJS
'=========================================================
skinparam sequenceMessageAlign center
title **إعادة تعيين كلمة المرور** — Password Reset Flow

actor "مستخدم\nUser" as U
participant "Client" as C
participant "authRoutes" as RT
control "authController" as AC
entity "PasswordReset" as PR
entity "User" as UM
entity "emailService\n(EmailJS)" as EM
entity "RefreshToken" as RTK

== 1) طلب إعادة التعيين (إرسال الكود) ==
U -> C : POST /api/auth/forgot-password\n{email}
C -> RT : /api/auth/forgot-password
RT -> AC : forgotPassword()
AC -> UM : User.findOne({email})
alt البريد غير مسجل
  AC --> C : 404 { البريد غير مسجل في المنصة }
else البريد مسجل
  AC -> PR : PasswordReset.deleteMany({user})\nحذف الأكواد القديمة
  AC -> AC : generateResetCode() → كود 6 أرقام
  AC -> PR : PasswordReset.create({\n  user, code, expiresAt: now+10min})
  AC -> EM : sendResetCode(email, code, firstName)
  EM --> AC : true (تم الإرسال)
  AC --> C : 200 { تم إرسال كود إعادة التعيين }
end

== 2) التحقق من الكود ==
U -> C : POST /api/auth/verify-reset-code\n{email, code}
C -> RT : /api/auth/verify-reset-code
RT -> AC : verifyResetCode()
AC -> UM : User.findOne({email})
AC -> PR : PasswordReset.findOne({\n  user, verified: false,\n  expiresAt: {$gt: now}})
alt لا يوجد كود صالح
  AC --> C : 400 { لا يوجد كود صالح }
else الكود غير صحيح
  AC --> C : 400 { الكود غير صحيح }
else الكود صحيح
  AC -> PR : verified = true\nsave()
  AC -> AC : jwt.sign({id, purpose:'reset',\n  resetId}, secret, {expiresIn:'10m'})
  AC --> C : 200 { resetToken }
end

== 3) إعادة التعيين ==
U -> C : POST /api/auth/reset-password\n{resetToken, newPassword}
C -> RT : /api/auth/reset-password
RT -> AC : resetPassword()
AC -> AC : jwt.verify(resetToken, secret)
alt التوكن غير صالح/منتهي
  AC --> C : 400 { التوكن غير صالح }
else صالح
  AC -> PR : PasswordReset.findOne({\n  _id: resetId, user: id,\n  verified: true})
  alt السجل غير صالح
    AC --> C : 400 { سجل غير صالح }
  else صالح
    AC -> UM : User.findById(id)
    AC -> UM : user.password = newPassword\nsave() → pre-save hook bcrypt
    AC -> PR : PasswordReset.deleteMany({user})\nحذف جميع الأكواد
    AC -> RTK : RefreshToken.updateMany(\n  {revokedAt: null}\n  → {revokedAt: now})\nإبطال جميع الجلسات
    AC --> C : 200 { تم إعادة التعيين بنجاح }
  end
end

@enduml
