@startuml post-report-sequence
'=========================================================
'  Sequence — الإبلاغ عن منشور
'=========================================================
skinparam sequenceMessageAlign center
title **الإبلاغ عن منشور** — Post Reporting Flow

actor "مستخدم\nUser" as U
actor "مشرف\nAdmin" as A
participant "postRoutes" as PR
control "postController" as PC
control "adminFinanceController" as AFC
entity "PostReport" as PPR
entity "Post" as P
entity "User (reported)" as UR
entity "Notification" as NF
entity "moderationService" as MOD

== 1) إبلاغ مستخدم عن منشور ==
U -> PR : POST /api/posts/:postId/report\n{reason, description?}
PR -> PR : reportLimiter (3/دقيقة)
PR -> PC : reportPost()
PC -> P : Post.findById(postId)
alt المنشور غير موجود
  PC --> U : 404 { المنشور غير موجود }
else صاحب المنشور يبلغ عن نفسه
  PC --> U : 400 { لا يمكنك الإبلاغ عن منشورك }
else
  PC -> PPR : PostReport.findOne({\n  post, reportedBy: me})
  alt بلّغ مسبقاً
    PC --> U : 400 { قمت بالإبلاغ مسبقاً }
  else
    PC -> PPR : PostReport.create({\n  post, reportedBy, reason,\n  status: 'pending'})
    PC -> P : Post.update({$inc: {\n  reportsCount: 1}})
    PC -> UR : User.update({$inc: {\n  profile.reportsCount: 1}})
    PC -> NF : إشعار لصاحب المنشور\n(post_reported)
    PC --> U : 200 { تم استلام بلاغك }

    ' ===== التحقق التلقائي من الحد =====
    PC -> P : Post.findById(postId)
    alt reportsCount >= 30
      PC -> P : status = 'hidden'\nsave()
      PC -> UR : User.findOne({\n  _id: post.user})
      PC -> MOD : applyWarning(userId,\n  'محتوى مخالف متكرر', 'post_reports')
      PC -> UR : User.update({\n  status: 'banned'})
      PC -> NF : إشعار للمستخدم\n(account_banned)
      PC -> NF : إشعار للمبلغ\n(post_hidden)
    elseif reportsCount >= 10
      PC -> P : status = 'hidden'\nsave()
      PC -> NF : إشعار للمستخدم\n(post_hidden)
    end
  end
end

== 2) عرض البلاغات (Admin) ==
A -> PR : GET /api/posts/admin/reports\n?status=pending
PR -> PC : getAllReports()
PC -> PPR : PostReport.find({status})\n.populate('post reportedBy')
PC --> A : 200 { reports[] }

== 3) مراجعة بلاغ (Admin) ==
A -> PR : PUT /api/posts/reports/:reportId/review\n{action: 'approve'|'reject', note}
PR -> PC : reviewReport()
PC -> PPR : PostReport.findOne({_id})
alt غير موجود
  PC --> A : 400 { البلاغ غير موجود }
else تمت مراجعته مسبقاً
  PC --> A : 400 { تمت مراجعة هذا البلاغ }
else action == approve
  PC -> PPR : status = 'reviewed'\nreviewedBy = admin\nadminNote = note\nsave()
  PC -> P : Post.status = 'hidden'\nsave()
  PC -> NF : إشعار للمبلغ\n(post_hidden: تمت الموافقة)
  PC --> A : 200 { تمت الموافقة على البلاغ }
else action == reject
  PC -> PPR : status = 'rejected'\nreviewedBy = admin\nadminNote = note\nsave()
  PC -> NF : إشعار للمبلغ\n(post_hidden: تم الرفض)
  PC --> A : 200 { تم رفض البلاغ }
end

@enduml
