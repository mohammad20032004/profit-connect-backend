@startuml erd
'=========================================================
'  ERD — علاقات الكيانات بين جداول MongoDB
'  (بدون حقول تفصيلية، فقط الكيانات والعلاقات والبطاقات)
'=========================================================
skinparam linetype ortho
skinparam shadowing false
title **Profit Connect** — Entity Relationship Diagram

entity "User" as user {
  *_id : ObjectId <<PK>>
  --
  email : string <<UQ>>
  username : string <<UQ>>
  role : enum
  status : enum
  isVerified : boolean
  emailVerifiedAt : date
  wallet.balance : number
  wallet.holding : number
  wallet.currency : string
  savedPosts[] : ObjectId
  notifications[] : embedded
  warnings[] : embedded
}

entity "RefreshToken" as refreshtoken {
  *_id : ObjectId <<PK>>
  --
  token : string <<UQ>>
  user : ObjectId <<FK>>
  expiresAt : date
}

entity "PasswordReset" as passwordreset {
  *_id : ObjectId <<PK>>
  --
  user : ObjectId <<FK>>
  code : string
  purpose : string
  verified : boolean
  expiresAt : date <<TTL>>
} <<IX>> (user, purpose)

entity "EmailVerification" as emailverification {
  *_id : ObjectId <<PK>>
  --
  user : ObjectId <<FK>>
  code : string
  verified : boolean
  expiresAt : date <<TTL>>
} <<IX>> (user)

entity "Company" as company {
  *_id : ObjectId <<PK>>
  --
  name : string <<UQ>>
  status : enum <<IX>>
  owner : ObjectId <<FK>>
  employees[] : embedded refs
  ratings[] : embedded
  followers[] : embedded
}

entity "Job" as job {
  *_id : ObjectId <<PK>>
  --
  title : string <<IX>>
  company : ObjectId <<FK>>
  status : enum <<IX>>
  postedBy : ObjectId <<FK>>
}

entity "JobApplication" as jobapp {
  *_id : ObjectId <<PK>>
  --
  job : ObjectId <<FK>>
  applicant : ObjectId <<FK>>
  status : enum
  } <<UQ>> (job, applicant)

entity "Project" as project {
  *_id : ObjectId <<PK>>
  --
  title : string
  category : string <<IX>>
  status : enum <<IX>>
  client : ObjectId <<FK>>
  budget.currency : string
  team[] : embedded refs
  milestones[] : embedded
  payments[] : embedded
}

entity "Proposal" as proposal {
  *_id : ObjectId <<PK>>
  --
  project : ObjectId <<FK>>
  freelancer : ObjectId <<FK>>
  bidAmount : number
  status : enum
  } <<UQ>> (project, freelancer)

entity "PlatformPayment" as payment {
  *_id : ObjectId <<PK>>
  --
  project : ObjectId <<FK>>
  payer : ObjectId <<FK>>
  payee : ObjectId <<FK>>
  proposal : ObjectId <<FK>>
  amount : number
  currency : string
  fee : number
  status : enum <<IX>>
}

entity "Withdrawal" as withdrawal {
  *_id : ObjectId <<PK>>
  --
  user : ObjectId <<FK>>
  amount : number
  currency : string
  status : enum <<IX>>
  accountDetails : embedded
}

entity "MoneyTransaction" as tx {
  *_id : ObjectId <<PK>>
  --
  user : ObjectId <<FK>>
  type : enum
  amount : number
  currency : string
  balanceAfter : number
  platformPayment : ObjectId <<FK>>
  withdrawal : ObjectId <<FK>>
  project : ObjectId <<FK>>
} <<IX>> (user, createdAt)

entity "Connection" as connection {
  *_id : ObjectId <<PK>>
  --
  requester : ObjectId <<FK>>
  recipient : ObjectId <<FK>>
  status : enum
  } <<UQ>> (requester, recipient)

entity "Conversation" as conversation {
  *_id : ObjectId <<PK>>
  --
  participants[] : ObjectId <<FK>>
  lastMessage : ObjectId <<FK>>
}

entity "Message" as message {
  *_id : ObjectId <<PK>>
  --
  conversation : ObjectId <<FK>>
  sender : ObjectId <<FK>>
  content : string
  isRead : boolean
} <<IX>> (conversation, createdAt)

entity "Post" as post {
  *_id : ObjectId <<PK>>
  --
  user : ObjectId <<FK>>
  content : string
  status : enum
  reportsCount : number
  aiProbability : number
  likes[] : ObjectId
  comments[] : embedded
}

entity "PostReport" as postreport {
  *_id : ObjectId <<PK>>
  --
  post : ObjectId <<FK>>
  reportedBy : ObjectId <<FK>>
  reason : enum
  status : enum
  reviewedBy : ObjectId <<FK>>
  } <<UQ>> (post, reportedBy)

entity "Salary" as salary {
  *_id : ObjectId <<PK>>
  --
  title : string <<IX>>
  country : string <<IX>>
  category : string <<IX>>
  medianSalaryUSD : number
} <<IX>> (title, country)

entity "ScoreHistory" as score {
  *_id : ObjectId <<PK>>
  --
  user : ObjectId <<FK>>
  actionKey : string <<IX>>
  points : number
}

entity "Setting" as setting {
  *_id : ObjectId <<PK>>
  --
  key : string <<UQ>>
  value : mixed
}

